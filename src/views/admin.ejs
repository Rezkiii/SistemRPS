<%- include('partials/header') %>

<div class="container-custom">
    <div class="card">
        <h2 class="card-title mb-6">Validasi User Baru</h2>
        <table class="min-w-full bg-white rounded-lg overflow-hidden">
            <thead>
                <tr>
                    <th class="px-4 py-2 text-left">Email</th>
                    <th class="px-4 py-2 text-left">Username</th>
                    <th class="px-4 py-2 text-left">Role</th>
                    <th class="px-4 py-2 text-left">Status</th>
                    <th class="px-4 py-2 text-left">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (users.length === 0) { %>
                    <tr><td colspan="5" class="text-center py-4 text-gray-500">Tidak ada user pending validasi.</td></tr>
                <% } %>
                <% users.forEach(function(user) { %>
                    <tr class="border-t">
                        <td class="px-4 py-2"><%= user.email %></td>
                        <td class="px-4 py-2"><%= user.username %></td>
                        <td class="px-4 py-2 capitalize"><%= user.role %></td>
                        <td class="px-4 py-2"><span class="inline-block px-2 py-1 rounded-full <%= user.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>"><%= user.status %></span></td>
                        <td class="px-4 py-2">
                            <% if (user.status === 'pending') { %>
                                <form action="/admin/validate/<%= user.id %>" method="POST" class="inline">
                                    <button class="btn-primary text-xs" type="submit">Validasi</button>
                                </form>
                            <% } else { %>
                                <span class="text-green-600 font-semibold text-xs">Tervalidasi</span>
                            <% } %>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</div>

<%- include('partials/footer') %>
