<%- include('partials/header') %>

<div class="container-custom flex justify-center items-start min-h-screen bg-gray-50 py-8">
    <div class="bg-white shadow-lg rounded-lg p-8 w-full max-w-3xl">
        <h2 class="text-2xl font-bold mb-6 text-blue-700 border-b pb-2">Detail RPS: <%= rps.nama_mk %></h2>
        <% if (rps) { %>
            <!-- Identitas Mata Kuliah -->
            <div class="mb-6">
                <h3 class="text-lg font-bold mt-8 mb-3 text-blue-700">Identitas Mata Kuliah</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div><span class="font-semibold text-gray-700">Kode Mata Kuliah:</span> <%= rps.kode_mk %></div>
                    <div><span class="font-semibold text-gray-700">Rumpun MK:</span> <%= rps.rumpun_mk %></div>
                    <div><span class="font-semibold text-gray-700">Semester:</span> <%= rps.semester %></div>
                    <div><span class="font-semibold text-gray-700">Tahun Akademik:</span> <%= rps.tahun_akademik %></div>
                    <div><span class="font-semibold text-gray-700">Bobot SKS:</span> <%= rps.sks_teori %> Teori, <%= rps.sks_praktikum %> Praktikum</div>
                    <div><span class="font-semibold text-gray-700">Mata Kuliah Syarat:</span> <%= rps.mk_syarat || '-' %></div>
                    <div><span class="font-semibold text-gray-700">Tanggal Penyusunan:</span> <%= new Date(rps.tanggal_penyusunan).toLocaleDateString() %></div>
                    <div class="md:col-span-2"><span class="font-semibold text-gray-700">Dosen Pengampu:</span> <%= (rps['dosen_pengampu[]'] || rps.dosen_pengampu || []).join(', ') %></div>
                    <div class="md:col-span-2"><span class="font-semibold text-gray-700">Deskripsi Singkat:</span><br><%= rps.deskripsi_singkat_mk %></div>
                </div>
            </div>

            <!-- Pustaka -->
            <div class="mb-6">
                <h3 class="text-lg font-bold mt-8 mb-3 text-blue-700">Pustaka</h3>
                <div><span class="font-semibold text-gray-700">Pustaka Utama:</span><br><%= (rps['pustaka_utama[]'] || rps.pustaka_utama || []).join('<br>') %></div>
                <div class="mt-4"><span class="font-semibold text-gray-700">Pustaka Pendukung:</span><br><%= (rps['pustaka_pendukung[]'] || rps.pustaka_pendukung || []).join('<br>') %></div>
            </div>

            <!-- Otorisasi -->
            <div class="mb-6">
                <h3 class="text-lg font-bold mt-8 mb-3 text-blue-700">Otorisasi</h3>
                 <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                    <div><span class="font-semibold text-gray-700">Dosen Pengembang RPS:</span> <%= rps.dosen_pengembang_rps %></div>
                    <div><span class="font-semibold text-gray-700">Koordinator Program Studi:</span> <%= rps.koordinator_program_studi %></div>
                    <div><span class="font-semibold text-gray-700">Penjamin Mutu:</span> <%= rps.penjamin_mutu %></div>
                </div>
            </div>

            <!-- Capaian Pembelajaran Lulusan -->
            <div class="mb-6">
                 <h3 class="text-lg font-bold mt-8 mb-3 text-blue-700">Capaian Pembelajaran Lulusan (CPL)</h3>
                <ul class="list-disc list-inside">
                <% (rps['cpl[]'] || rps.cpl || []).forEach(cpl => { %>
                    <li>
                        <strong><%= cpl %>:</strong>
                        <% if (rps.cpl_descriptions && rps.cpl_descriptions[cpl]) { %>
                            <%= rps.cpl_descriptions[cpl] %>
                        <% } else { %>
                            <span class="text-gray-500">No specific description provided.</span>
                        <% } %>
                    </li>
                <% }); %>
                </ul>
            </div>

            <!-- CPMK -->
            <h3 class="text-lg font-bold mt-8 mb-3 text-blue-700">CPMK</h3>
            <div class="overflow-x-auto">
            <table class="table-auto w-full mb-6 border rounded overflow-hidden">
                <thead class="bg-blue-100">
                    <tr>
                        <th class="px-2 py-2">ID</th>
                        <th class="px-2 py-2">Kode CPL</th>
                        <th class="px-2 py-2">Deskripsi CPL</th>
                        <th class="px-2 py-2">Deskripsi CPMK</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                <% Object.keys(rps).filter(k => k.startsWith('cpmk[')).forEach(function(key) { 
                    var match = key.match(/^cpmk\[(CPMK\d+)\]\[(.+)\]$/);
                    if (match && match[2] === 'deskripsi') {
                        var id = match[1];
                        var cpl_code = rps[`cpmk[${id}][cpl_code]`];
                        var cpl_desc = rps[`cpmk[${id}][cpl_description]`];
                        var deskripsi = rps[key];
                %>
                    <tr>
                        <td class="px-2 py-2"><%= id %></td>
                        <td class="px-2 py-2"><%= cpl_code %></td>
                        <td class="px-2 py-2"><%= cpl_desc %></td>
                        <td class="px-2 py-2"><%= deskripsi %></td>
                    </tr>
                <% } }); %>
                </tbody>
            </table>
            </div>

            <!-- sub-CPMK -->
            <h3 class="text-lg font-bold mt-8 mb-3 text-blue-700">Sub-CPMK</h3>
            <div class="overflow-x-auto">
            <table class="table-auto w-full mb-6 border rounded overflow-hidden">
                <thead class="bg-blue-100">
                    <tr>
                        <th class="px-2 py-2">CPMK</th>
                        <th class="px-2 py-2">Pekan</th>
                        <th class="px-2 py-2">Indikator</th>
                        <th class="px-2 py-2">Teknik & Kriteria</th>
                        <th class="px-2 py-2">Metode Luring</th>
                        <th class="px-2 py-2">Metode Daring</th>
                        <th class="px-2 py-2">Materi</th>
                        <th class="px-2 py-2">Bobot</th>
                        <th class="px-2 py-2">Deskripsi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                <% Object.keys(rps).filter(k => k.startsWith('sub_cpmk[')).forEach(function(key) { 
                    var match = key.match(/^sub_cpmk\[(CPMK\d+)\]\[(\d+)\]\[(.+)\]$/);
                    if (match && match[3] === 'deskripsi') {
                        var cpmk = match[1];
                        var sub = match[2];
                        var deskripsi = rps[key];
                        var pekan = rps[`sub_cpmk[${cpmk}][${sub}][pekan]`] || rps[`sub_cpmk[${cpmk}][${sub}][pekan_awal]`] || '';
                        var pekan_akhir = rps[`sub_cpmk[${cpmk}][${sub}][pekan_akhir]`] || '';
                        var indikator = rps[`sub_cpmk[${cpmk}][${sub}][indikator]`] || '';
                        var teknik = rps[`sub_cpmk[${cpmk}][${sub}][teknik_kriteria]`] || '';
                        var luring = rps[`sub_cpmk[${cpmk}][${sub}][metode_luring]`] || '';
                        var daring = rps[`sub_cpmk[${cpmk}][${sub}][metode_daring]`] || '';
                        var materi = rps[`sub_cpmk[${cpmk}][${sub}][materi]`] || '';
                        var bobot = rps[`sub_cpmk[${cpmk}][${sub}][bobot]`] || '';
                %>
                    <tr>
                        <td class="px-2 py-2"><%= cpmk %></td>
                        <td class="px-2 py-2"><%= pekan %><% if (pekan_akhir) { %> - <%= pekan_akhir %><% } %></td>
                        <td class="px-2 py-2"><%= indikator %></td>
                        <td class="px-2 py-2"><%= teknik %></td>
                        <td class="px-2 py-2"><%= luring %></td>
                        <td class="px-2 py-2"><%= daring %></td>
                        <td class="px-2 py-2"><%= materi %></td>
                        <td class="px-2 py-2"><%= bobot %></td>
                        <td class="px-2 py-2"><%= deskripsi %></td>
                    </tr>
                <% } }); %>
                </tbody>
            </table>
            </div>
            <a href="/history" class="btn-secondary mt-4 px-4 py-2 rounded bg-gray-500 text-white hover:bg-gray-600 inline-block">Kembali</a>
        <% } else { %>
            <div class="text-center py-8">
                <p class="text-red-600 font-semibold mb-4">Data RPS tidak ditemukan.</p>
                <a href="/history" class="btn-secondary mt-4 px-4 py-2 rounded bg-gray-500 text-white hover:bg-gray-600 inline-block">Kembali</a>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>
