<%- include('partials/header') %>

<div class="container-custom">
    <form id="rps-form" action="/edit-rps/<%= rps.id %>" method="POST">
        <div class="card">
            <h2 class="card-title">Edit RPS: <%= rps.nama_mk %></h2>
            
            <!-- Identitas Mata Kuliah -->
            <fieldset class="border p-4 rounded-md mb-6">
                <legend class="text-lg font-semibold px-2">Identitas Mata Kuliah</legend>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="label" for="nama_mk">Nama Mata Kuliah</label>
                        <input class="input" id="nama_mk" name="nama_mk" type="text" value="<%= rps.nama_mk %>" required>
                    </div>
                    <div>
                        <label class="label" for="kode_mk">Kode Mata Kuliah</label>
                        <input class="input" id="kode_mk" name="kode_mk" type="text" value="<%= rps.kode_mk %>" required>
                    </div>
                    <div>
                        <label class="label" for="rumpun_mk">Rumpun Mata Kuliah</label>
                        <select class="input" id="rumpun_mk" name="rumpun_mk" required>
                            <option value="Mata Kuliah Keahlian" <%= rps.rumpun_mk === 'Mata Kuliah Keahlian' ? 'selected' : '' %>>Mata Kuliah Keahlian</option>
                            <option value="Mata Kuliah Dasar Keahlian" <%= rps.rumpun_mk === 'Mata Kuliah Dasar Keahlian' ? 'selected' : '' %>>Mata Kuliah Dasar Keahlian</option>
                            <option value="Mata Kuliah Umum" <%= rps.rumpun_mk === 'Mata Kuliah Umum' ? 'selected' : '' %>>Mata Kuliah Umum</option>
                        </select>
                    </div>
                    <div>
                        <label class="label" for="semester">Semester Ke-</label>
                        <select class="input" id="semester" name="semester" required>
                            <% for(let i=1; i <= 8; i++) { %>
                                <option value="<%= i %>" <%= rps.semester == i ? 'selected' : '' %>><%= i %></option>
                            <% } %>
                        </select>
                    </div>
                    <div>
                        <label class="label" for="tahun_akademik">Tahun Akademik</label>
                        <input class="input" id="tahun_akademik" name="tahun_akademik" type="text" value="<%= rps.tahun_akademik %>" required placeholder="Contoh: 2025/2026">
                    </div>
                    <div>
                        <label class="label" for="mk_syarat">Mata Kuliah Syarat</label>
                        <input class="input" id="mk_syarat" name="mk_syarat" type="text" value="<%= rps.mk_syarat || '' %>" placeholder="Boleh dikosongkan">
                    </div>
                    <div class="md:col-span-2">
                        <div class="flex flex-col md:flex-row gap-4">
                            <div class="w-full">
                                <label class="label" for="sks_teori">Bobot SKS Teori</label>
                                <input class="input" id="sks_teori" name="sks_teori" type="number" min="0" value="<%= rps.sks_teori %>" required>
                            </div>
                            <div class="w-full">
                                <label class="label" for="sks_praktikum">Bobot SKS Praktikum</label>
                                <input class="input" id="sks_praktikum" name="sks_praktikum" type="number" min="0" value="<%= rps.sks_praktikum %>" required>
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="label" for="tanggal_penyusunan">Tanggal Penyusunan</label>
                        <input class="input" id="tanggal_penyusunan" name="tanggal_penyusunan" type="date" value="<%= rps.tanggal_penyusunan %>" required>
                    </div>
                    <div id="dosen-pengampu-container">
                        <label class="label">Dosen Pengampu</label>
                        <% if (rps.dosen_pengampu && rps.dosen_pengampu.length > 0) { %>
                            <% rps.dosen_pengampu.forEach((dosen, index) => { %>
                                <div class="flex items-center mb-2">
                                    <input class="input" name="dosen_pengampu[]" type="text" value="<%= dosen %>" required>
                                    <% if (index === 0) { %>
                                        <button type="button" class="ml-2 btn-primary" style="padding:0.5rem 1rem;min-width:2.5rem;" onclick="addDosenPengampu()">+</button>
                                    <% } else { %>
                                        <button type="button" class="ml-2 btn-danger" style="padding:0.5rem 1rem;min-width:2.5rem;" onclick="this.parentElement.remove()">-</button>
                                    <% } %>
                                </div>
                            <% }); %>
                        <% } else { %>
                             <div class="flex items-center mb-2">
                                <input class="input" name="dosen_pengampu[]" type="text" required>
                                <button type="button" class="ml-2 btn-primary" style="padding:0.5rem 1rem;min-width:2.5rem;" onclick="addDosenPengampu()">+</button>
                            </div>
                        <% } %>
                    </div>
                    <div class="md:col-span-2">
                        <label class="label" for="deskripsi_singkat_mk">Deskripsi Singkat Mata Kuliah</label>
                        <textarea class="input" id="deskripsi_singkat_mk" name="deskripsi_singkat_mk" rows="3" required><%= rps.deskripsi_singkat_mk %></textarea>
                    </div>
                    <div class="flex flex-col md:flex-row gap-4 md:col-span-2">
                      <div class="w-full">
                        <label class="label">Pustaka Utama</label>
                        <div id="pustaka-utama-list" class="flex flex-col gap-2">
                           <% if (rps.pustaka_utama && rps.pustaka_utama.length > 0) { %>
                                <% rps.pustaka_utama.forEach((pustaka, index) => { %>
                                  <div class="flex items-center mb-2">
                                    <input class="input" name="pustaka_utama[]" type="text" value="<%= pustaka %>" required>
                                     <% if (index === 0) { %>
                                        <button type="button" class="ml-2 btn-primary" style="padding:0.5rem 1rem;min-width:2.5rem;" onclick="addPustakaUtama()">+</button>
                                    <% } else { %>
                                        <button type="button" class="ml-2 btn-danger" style="padding:0.5rem 1rem;min-width:2.5rem;" onclick="this.parentElement.remove()">-</button>
                                    <% } %>
                                  </div>
                                <% }); %>
                           <% } else { %>
                                <div class="flex items-center mb-2">
                                    <input class="input" name="pustaka_utama[]" type="text" required>
                                    <button type="button" class="ml-2 btn-primary" style="padding:0.5rem 1rem;min-width:2.5rem;" onclick="addPustakaUtama()">+</button>
                                </div>
                           <% } %>
                        </div>
                      </div>
                      <div class="w-full">
                        <label class="label">Pustaka Pendukung</label>
                        <div id="pustaka-pendukung-list" class="flex flex-col gap-2">
                          <% if (rps.pustaka_pendukung && rps.pustaka_pendukung.length > 0) { %>
                                <% rps.pustaka_pendukung.forEach((pustaka, index) => { %>
                                  <div class="flex items-center mb-2">
                                    <input class="input" name="pustaka_pendukung[]" type="text" value="<%= pustaka %>" required>
                                     <% if (index === 0) { %>
                                        <button type="button" class="ml-2 btn-primary" style="padding:0.5rem 1rem;min-width:2.5rem;" onclick="addPustakaPendukung()">+</button>
                                    <% } else { %>
                                        <button type="button" class="ml-2 btn-danger" style="padding:0.5rem 1rem;min-width:2.5rem;" onclick="this.parentElement.remove()">-</button>
                                    <% } %>
                                  </div>
                                <% }); %>
                           <% } else { %>
                                <div class="flex items-center mb-2">
                                    <input class="input" name="pustaka_pendukung[]" type="text" required>
                                    <button type="button" class="ml-2 btn-primary" style="padding:0.5rem 1rem;min-width:2.5rem;" onclick="addPustakaPendukung()">+</button>
                                </div>
                           <% } %>
                        </div>
                      </div>
                    </div>
                </div>
            </fieldset>

            <!-- Otorisasi -->
            <fieldset class="border p-4 rounded-md mb-6">
                <legend class="text-lg font-semibold px-2">Otorisasi</legend>
                 <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="label" for="penjamin_mutu">Penjamin Mutu</label>
                        <input class="input" id="penjamin_mutu" name="penjamin_mutu" type="text" value="<%= rps.penjamin_mutu %>" required>
                    </div>
                    <div>
                        <label class="label" for="dosen_pengembang_rps">Dosen Pengembang RPS</label>
                        <input class="input" id="dosen_pengembang_rps" name="dosen_pengembang_rps" type="text" value="<%= user.username %>" readonly>
                    </div>
                    <div>
                        <label class="label" for="koordinator_program_studi">Koordinator Program Studi</label>
                        <input class="input" id="koordinator_program_studi" name="koordinator_program_studi" value="<%= rps.koordinator_program_studi %>" type="text" required>
                    </div>
                </div>
            </fieldset>
            
            <!-- Capaian Pembelajaran Lulusan -->
            <fieldset class="border p-4 rounded-md mb-6">
                <legend class="text-lg font-semibold px-2">Capaian Pembelajaran Lulusan (CPL)</legend>
                <div class="grid grid-cols-1 gap-2">
                    <%
                    const cpls = [
                        { code: 'CPL01', desc: 'Menunjukkan sikap profesional yang berlandaskan ketakwaan, etika, integritas, nasionalisme, dan kepedulian sosial dalam menjalankan tugas di bidang teknik komputer dan jaringan' },
                        { code: 'CPL02', desc: 'Menerapkan konsep matematika, komputasi, dan kecerdasan buatan dalam penyelesaian masalah teknis jaringan secara sistematis.' },
                        { code: 'CPL03', desc: 'Mengelola pembelajaran sepanjang hayat untuk pengembangan profesional diri dalam lingkungan kerja global yang dinamis dan kompetitif.'},
                        { code: 'CPL04', desc: 'Menyelesaikan permasalahan dan tugas teknis jaringan komputer melalui perancangan, konfigurasi, pengujian, dan pengelolaan perangkat serta infrastruktur jaringan pada berbagai skala topologi dalam konteks operasional sistem komunikasi data dan administrasi jaringan.'},
                        { code: 'CPL05', desc: 'Merancang infrastruktur jaringan komputer serta sistem virtualisasi dan komputasi awan dalam konteks pembangunan dan pengelolaan layanan TIK yang fleksibel, skalabel, dan terotomasi. (C6)'},
                        { code: 'CPL06', desc: 'Mengintegrasikan teknologi jaringan wireless & mobile, sistem tertanam, dan komputasi terdistribusi dalam perancangan dan pengelolaan solusi komunikasi data nirkabel yang andal dan adaptif untuk lingkungan industri dan IoT.'},
                        { code: 'CPL07', desc: 'Mengembangkan solusi berbasis IoT dan sistem tertanam dalam integrasi perangkat keras, perangkat lunak, dan komunikasi data.'},
                        { code: 'CPL08', desc: 'Merancang solusi berbasis prinsip keamanan siber dan pembelajaran mesin untuk memitigasi risiko serta memperkuat ketahanan infrastruktur informasi'},
                        { code: 'CPL09', desc: 'Mengelola infrastruktur virtualisasi dan komputasi awan beserta pipeline DevOps dalam otomatisasi penyediaan layanan TIK yang skalabel, andal, dan berkelanjutan'},
                        { code: 'CPL10', desc: 'Mengkomunikasikan ide dan solusi teknis dalam kegiatan penelitian atau kerja sama tim multidisiplin secara ilmiah dan profesional.'}
                    ];
                    %>
                    <% cpls.forEach(cpl => { %>
                        <div>
                            <input type="checkbox" name="cpl[]" value="<%= cpl.code %>" data-description="<%= cpl.desc %>" <%= (rps.cpl && rps.cpl.includes(cpl.code)) ? 'checked' : '' %>>
                            <%= cpl.code %> <%= cpl.desc %>
                        </div>
                    <% }); %>
                </div>
            </fieldset>

            <!-- Capaian Pembelajaran Matakuliah -->
            <fieldset class="border p-4 rounded-md mb-6">
                <legend class="text-lg font-semibold px-2">Capaian Pembelajaran Matakuliah (CPMK)</legend>
                <div id="cpmk-container">
                    <!-- CPMK will be rendered here -->
                </div>
            </fieldset>

            <!-- Sub-CPMK -->
            <fieldset class="border p-4 rounded-md mb-6">
                <legend class="text-lg font-semibold px-2">Sub-CPMK</legend>
                <div id="sub-cpmk-container">
                    <!-- Sub-CPMK will be rendered here -->
                </div>
            </fieldset>

            <div class="flex justify-end mt-4">
                <a href="/history" class="btn-secondary mr-2">Cancel</a>
                <button class="btn-primary" type="submit">Update RPS</button>
            </div>
        </div>
    </form>
</div>

<script src="/js/script.js"></script>
<%- include('partials/footer') %>
<script>
document.addEventListener('DOMContentLoaded', function() {
    const rpsData = <%- JSON.stringify(rps) %>;
    const cplCheckboxes = document.querySelectorAll('input[name="cpl[]"]');
    const cpmkContainer = document.getElementById('cpmk-container');
    const subCpmkContainer = document.getElementById('sub-cpmk-container');
    const cpls = <%- JSON.stringify(cpls) %>;

    // Function to generate CPMK fields
    function generateCpmkFields() {
        cpmkContainer.innerHTML = '';
        const selectedCpls = Array.from(cplCheckboxes).filter(cb => cb.checked);

        selectedCpls.forEach((cpl, index) => {
            const cpmkId = `CPMK${String(index + 1).padStart(2, '0')}`;
            const cplData = cpls.find(c => c.code === cpl.value);
            const cpmkKey = `cpmk[${cpmkId}][deskripsi]`;
            const existingCpmkDescription = rpsData[cpmkKey] || '';

            const cpmkDiv = document.createElement('div');
            cpmkDiv.className = 'cpmk-item mb-4 p-3 border rounded-md';
            cpmkDiv.innerHTML = `
                <h4 class="font-semibold text-md mb-2">${cpmkId} (merujuk pada ${cpl.value})</h4>
                <input type="hidden" name="cpmk[${cpmkId}][cpl_code]" value="${cpl.value}">
                <input type="hidden" name="cpmk[${cpmkId}][cpl_description]" value="${cplData ? cplData.desc : ''}">
                <label class="label">Deskripsi CPMK:</label>
                <textarea class="input" name="cpmk[${cpmkId}][deskripsi]" required>${existingCpmkDescription}</textarea>
            `;
            cpmkContainer.appendChild(cpmkDiv);
        });
        generateSubCpmkFields();
    }

    // Function to generate Sub-CPMK fields
    function generateSubCpmkFields() {
        subCpmkContainer.innerHTML = '';
        const cpmkItems = document.querySelectorAll('.cpmk-item');
        
        cpmkItems.forEach((cpmkItem, cpmkIndex) => {
            const cpmkId = `CPMK${String(cpmkIndex + 1).padStart(2, '0')}`;
            
            const subCpmkDiv = document.createElement('div');
            subCpmkDiv.id = `sub-cpmk-fields-${cpmkId}`;
            subCpmkDiv.className = 'sub-cpmk-group mb-4 p-3 border rounded-md';
            subCpmkDiv.innerHTML = `<h4 class="font-semibold text-md mb-2">Detail untuk ${cpmkId}</h4>`;
            
            // Find all sub-cpmks related to the current cpmkId
            const subCpmkKeys = Object.keys(rpsData).filter(key => key.startsWith(`sub_cpmk[${cpmkId}]`));
            const subCpmkData = {};

            subCpmkKeys.forEach(key => {
                const match = key.match(/\[(\d+)\]\[(\w+)\]/);
                if (match) {
                    const index = match[1];
                    const field = match[2];
                    if (!subCpmkData[index]) {
                        subCpmkData[index] = {};
                    }
                    subCpmkData[index][field] = rpsData[key];
                }
            });

            Object.keys(subCpmkData).forEach(index => {
                subCpmkDiv.innerHTML += createSubCpmkHtml(cpmkId, index, subCpmkData[index]);
            });
            
            const addButton = document.createElement('button');
            addButton.type = 'button';
            addButton.className = 'btn-primary mt-2';
            addButton.textContent = `+ Tambah Sub-CPMK untuk ${cpmkId}`;
            addButton.onclick = () => {
                const newIndex = (subCpmkDiv.querySelectorAll('.sub-cpmk-item').length) + 1;
                const newItem = document.createElement('div');
                newItem.innerHTML = createSubCpmkHtml(cpmkId, newIndex);
                subCpmkDiv.insertBefore(newItem.firstChild, addButton);
            };
            
            subCpmkDiv.appendChild(addButton);
            subCpmkContainer.appendChild(subCpmkDiv);
        });
    }
    
    function createSubCpmkHtml(cpmkId, index, data = {}) {
        return `
            <div class="sub-cpmk-item border-t pt-3 mt-3">
                <div class="flex justify-between items-center mb-2">
                    <h5 class="font-semibold">Sub-CPMK #${index}</h5>
                    <button type="button" class="btn-danger" onclick="this.closest('.sub-cpmk-item').remove()">Hapus</button>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="label">Deskripsi Sub-CPMK</label>
                        <input class="input" name="sub_cpmk[${cpmkId}][${index}][deskripsi]" type="text" value="${data.deskripsi || ''}" required>
                    </div>
                     <div>
                        <label class="label">Pekan ke-</label>
                        <input class="input" name="sub_cpmk[${cpmkId}][${index}][pekan]" type="text" value="${data.pekan || ''}" required placeholder="Contoh: 1-2">
                    </div>
                    <div>
                        <label class="label">Indikator Penilaian</label>
                        <input class="input" name="sub_cpmk[${cpmkId}][${index}][indikator]" type="text" value="${data.indikator || ''}" required>
                    </div>
                    <div>
                        <label class="label">Teknik & Kriteria Penilaian</label>
                        <input class="input" name="sub_cpmk[${cpmkId}][${index}][teknik_kriteria]" type="text" value="${data.teknik_kriteria || ''}" required>
                    </div>
                    <div>
                        <label class="label">Metode Pembelajaran (Luring)</label>
                        <input class="input" name="sub_cpmk[${cpmkId}][${index}][metode_luring]" type="text" value="${data.metode_luring || ''}" placeholder="Opsional">
                    </div>
                    <div>
                        <label class="label">Metode Pembelajaran (Daring)</label>
                        <input class="input" name="sub_cpmk[${cpmkId}][${index}][metode_daring]" type="text" value="${data.metode_daring || ''}" placeholder="Opsional">
                    </div>
                    <div class="md:col-span-2">
                        <label class="label">Materi Pembelajaran</label>
                        <input class="input" name="sub_cpmk[${cpmkId}][${index}][materi]" type="text" value="${data.materi || ''}" required>
                    </div>
                    <div>
                        <label class="label">Bobot Penilaian (%)</label>
                        <input class="input" name="sub_cpmk[${cpmkId}][${index}][bobot]" type="number" min="0" max="100" value="${data.bobot || ''}" required>
                    </div>
                </div>
            </div>
        `;
    }

    cplCheckboxes.forEach(cb => {
        cb.addEventListener('change', generateCpmkFields);
    });

    // Initial generation
    generateCpmkFields();
});
</script>